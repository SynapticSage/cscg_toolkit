# direnv configuration for chmm_julia
# Automatically activates .venv when entering this directory
#
# Setup:
#   1. Install direnv: brew install direnv (macOS) or apt install direnv (Linux)
#   2. Add to shell: eval "$(direnv hook bash)" or eval "$(direnv hook zsh)"
#   3. Allow this file: direnv allow
#
# Created: 2025-11-14

source .venv/bin/activate
